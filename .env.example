# Copy to .env for local runs. On Render set these in the dashboard.

# --- Required (unchanged from v1) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_VERIFIED_FROM=PetaLog <no-reply@petalog.in>

# --- Optional, unchanged from v1 ---
# Accepted as a bearer token only while ALLOW_ANON_KEY_AUTH=true (transition).
SUPABASE_ANON_KEY=
SUPABASE_LOGS_TABLE=log-man
ENABLE_DEV_ROUTE=false
PORT=5000

# --- New in v2 ---
# Shared secret for the report-dispatch edge function (and operators).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
REPORTS_API_SECRET=
# This service's public URL (needed for unsubscribe links), e.g. https://<name>.onrender.com
REPORTS_PUBLIC_URL=
# Accept the public anon key on /send-reports (limited). Set false after the switch-over.
ALLOW_ANON_KEY_AUTH=true
# Where the operator summary goes (default: the SES_VERIFIED_FROM address) and when.
ADMIN_REPORT_EMAIL=
ADMIN_SUMMARY_MODE=failures
# xlsx | csv | none
REPORT_ATTACHMENT_FORMAT=xlsx
# Sends before this hour (owner's timezone) report the previous full day.
REPORT_MORNING_CUTOFF_HOUR=12
# How long after the preferred time a missed send may still go out.
DISPATCH_CATCHUP_MINUTES=180
DISPATCH_MAX_OWNERS=25
# true = owners who never saved report settings also get the 21:00 IST report.
INCLUDE_OWNERS_WITHOUT_SCHEDULE=false
# Optional extras
APP_URL=https://petalog.in
BRAND_LOGO_URL=https://petalog.in/android-chrome-512x512.png
SES_CONFIGURATION_SET=
UNSUBSCRIBE_SECRET=
DELIVERY_TRACKING=true
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_STALE_MINUTES=20
LOG_LEVEL=INFO
